global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    env: "admiq"

# No Alertmanager/alert rules deployed here either - see the same note in
# the root prometheus.yml used by local docker-compose.

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # node-exporter is intentionally not scraped on Render: it reports on the
  # HOST machine's /proc and /sys, which Render doesn't let you mount (you
  # don't manage the underlying host in a PaaS model) - Render's own
  # dashboard already gives you per-service CPU/memory graphs, which is
  # the equivalent signal here.

  - job_name: "redis-exporter"
    static_configs:
      - targets: ["__REDIS_EXPORTER_TARGET__"]

  - job_name: "supabase"
    scheme: https
    metrics_path: "/customer/v1/privileged/metrics"
    static_configs:
      - targets: ["bgdhdkdktngshwnesgkf.supabase.co"]
    basic_auth:
      username: "username"
      password: "__SUPABASE_METRICS_PASSWORD__"

  - job_name: "backend"
    metrics_path: "/router/metrics"
    static_configs:
      - targets: ["__BACKEND_METRICS_TARGET__"]
