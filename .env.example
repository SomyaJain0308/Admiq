GEMINI_API_KEY=get_yours_from_google_ai_studio
LANGCHAIN_TRACING_KEY=true
LANGCHAIN_API_KEY=get_yours_from_langgraph
LANGCHAIN_PROJECT=CollegeChatbot
APP_ENV=developnebt
LOG_LEVEL=INFO
RATE_LIMIT=20/minute
CACHE_TTL_SECONDS=300
MAX_PRIMARY_RETRIES=2
MAX_FALLBACK_RETRIES=2
MAX_RETRIEVAL_RETRIES=2
SESSION_TOKEN_BUDGET=200000
RETRIEVAL_DISTANCE_THRESHOLD=0.40
REDIS_DATABASE_URL=get_yours_from_upstash
DATABASE_URL=get_yours_from_supabase
WHATSAPP_VERIFY_TOKEN=some-long-random-secret
META_APP_SECRET=get_yours_from_meta
WHATSAPP_ACCESS_TOKEN=get-yours-from-meta

# URL of the deployed frontend (no trailing slash) - used to build the links
# inside password-reset and staff-invite emails, e.g. https://yourapp.vercel.app
FRONTEND_URL=https://admiq-v1.vercel.app

# Resend (https://resend.com) - sends password-reset and staff-invite emails.
# Leave RESEND_API_KEY blank to disable real sending: the app still works,
# emails just get logged instead (useful for local dev).
RESEND_API_KEY=get_yours_from_resend.com
# Must be on a domain verified in your Resend dashboard, or leave as
# onboarding@resend.dev to test without setting up a domain (can only
# deliver to the email address your Resend account was created with).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Internal cost reporting (backend/app/api/v1/routers/costs.py) - a long
# random secret, distinct from any other token in this file. Required to
# call GET /internal/costs/{college_id}/stats at all (it fails closed with
# a 503 if left blank). This endpoint is intentionally NOT used by the
# staff-facing frontend/dashboard - keep it that way.
COST_REPORTING_TOKEN=some-other-long-random-secret

# $ per WhatsApp conversation, by Meta's conversation category. Get your
# actual rates from Meta Business Manager > WhatsApp Manager > Overview for
# your market - these default to 0.0 as placeholders. Free-form replies
# inside the 24h customer-service window are billed as "service"
# conversations (WHATSAPP_SESSION_MESSAGE_COST_USD), usually free.
WHATSAPP_SESSION_MESSAGE_COST_USD=0.0
WHATSAPP_UTILITY_CONVERSATION_COST_USD=0.0
WHATSAPP_MARKETING_CONVERSATION_COST_USD=0.0

# Grafana (docker-compose.yml) - your own internal dashboard, not part of
# the deployed app. GRAFANA_ADMIN_PASSWORD replaces the "admin" default in
# docker-compose.yml; pick something real once this is deployed anywhere
# reachable. GRAFANA_PG_* let Grafana query cost_events/students/etc.
# directly for the cost dashboard - get these from Supabase's dashboard
# (Project Settings > Database > Connection info; use the direct/session
# connection, not the transaction pooler). Ideally create a read-only
# Postgres role for Grafana rather than reusing your app's DB user, since
# Grafana only ever needs SELECT.
GRAFANA_ADMIN_PASSWORD=change-me-before-deploying
GRAFANA_PG_HOST=db.your-project-ref.supabase.co
GRAFANA_PG_PORT=5432
GRAFANA_PG_DATABASE=postgres
GRAFANA_PG_USER=postgres
GRAFANA_PG_PASSWORD=your-supabase-db-password