GEMINI_API_KEY=get_yours_from_google_ai_studio
LANGCHAIN_TRACING_KEY=true
LANGCHAIN_API_KEY=get_yours_from_langgraph
LANGCHAIN_PROJECT=CollegeChatbot
APP_ENV=developnebt
LOG_LEVEL=INFO
RATE_LIMIT=20/minute
CACHE_TTL_SECONDS=300
MAX_PRIMARY_RETRIES=2
MAX_FALLBACK_RETRIES=2
MAX_RETRIEVAL_RETRIES=2
SESSION_TOKEN_BUDGET=200000
RETRIEVAL_DISTANCE_THRESHOLD=0.40
REDIS_DATABASE_URL=get_yours_from_upstash
DATABASE_URL=get_yours_from_supabase
WHATSAPP_VERIFY_TOKEN=some-long-random-secret
META_APP_SECRET=get_yours_from_meta
WHATSAPP_ACCESS_TOKEN=get-yours-from-meta

# URL of the deployed frontend (no trailing slash) - used to build the links
# inside password-reset and staff-invite emails, e.g. https://yourapp.vercel.app
FRONTEND_URL=https://admiq-v1.vercel.app

# Resend (https://resend.com) - sends password-reset and staff-invite emails.
# Leave RESEND_API_KEY blank to disable real sending: the app still works,
# emails just get logged instead (useful for local dev).
RESEND_API_KEY=get_yours_from_resend.com
# Must be on a domain verified in your Resend dashboard, or leave as
# onboarding@resend.dev to test without setting up a domain (can only
# deliver to the email address your Resend account was created with).
RESEND_FROM_EMAIL=onboarding@resend.dev