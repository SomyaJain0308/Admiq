          "datasource": {
            "type": "postgres",
            "uid": "admiq-postgres"
          },
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, cost_type AS metric, SUM(cost_usd) AS value FROM cost_events WHERE college_id = $college_id::int AND $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
