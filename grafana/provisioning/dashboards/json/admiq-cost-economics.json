          },
          "format": "table",
          "rawSql": "SELECT stage AS metric, SUM(cost_usd) AS value FROM cost_events WHERE college_id = $college_id::int AND stage IS NOT NULL GROUP BY stage ORDER BY value DESC LIMIT 10",
