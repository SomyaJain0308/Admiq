    {
      "id": 13,
      "type": "bargauge",
      "title": "Cost by stage (top 10) - where retries/fallback burn money",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "postgres",
