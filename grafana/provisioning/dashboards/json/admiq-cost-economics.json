    {
      "id": 14,
      "type": "row",
      "title": "Efficiency: escalated vs self-served sessions",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Avg session cost - escalated to low-confidence queue vs self-served",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "postgres",
        "uid": "admiq-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "admiq-postgres"
          },
          "format": "table",
          "rawSql": "WITH escalated AS (  SELECT DISTINCT m.session_id  FROM low_confidence_queries lcq  JOIN messages m ON m.college_id = lcq.college_id AND m.message_id = lcq.question_message_id  WHERE lcq.college_id = $college_id::int AND m.session_id IS NOT NULL), per_session AS (  SELECT ss.session_id, COALESCE(SUM(ce.cost_usd),0) AS total_cost  FROM student_sessions ss  LEFT JOIN cost_events ce ON ce.college_id = ss.college_id AND ce.session_id = ss.session_id  WHERE ss.college_id = $college_id::int  GROUP BY ss.session_id) SELECT  AVG(total_cost) FILTER (WHERE session_id IN (SELECT session_id FROM escalated)) AS \"Escalated\",  AVG(total_cost) FILTER (WHERE session_id NOT IN (SELECT session_id FROM escalated)) AS \"Self-served\" FROM per_session",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {},
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    }
