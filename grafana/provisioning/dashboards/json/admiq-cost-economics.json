    {
      "id": 8,
      "type": "stat",
      "title": "Cost per student - avg / median / p95",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "admiq-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "admiq-postgres"
          },
          "format": "table",
          "rawSql": "WITH per_student AS (  SELECT s.student_id, COALESCE(SUM(ce.cost_usd),0) AS total_cost  FROM students s  LEFT JOIN cost_events ce ON ce.college_id = s.college_id AND ce.student_id = s.student_id  WHERE s.college_id = $college_id::int  GROUP BY s.student_id) SELECT  AVG(total_cost) AS \"Avg\",  percentile_cont(0.5) WITHIN GROUP (ORDER BY total_cost) AS \"Median\",  percentile_cont(0.95) WITHIN GROUP (ORDER BY total_cost) AS \"P95\" FROM per_student",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {},
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Cost per session - avg / median",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "admiq-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "admiq-postgres"
          },
          "format": "table",
          "rawSql": "WITH per_session AS (  SELECT ss.session_id, COALESCE(SUM(ce.cost_usd),0) AS total_cost  FROM student_sessions ss  LEFT JOIN cost_events ce ON ce.college_id = ss.college_id AND ce.session_id = ss.session_id  WHERE ss.college_id = $college_id::int  GROUP BY ss.session_id) SELECT  AVG(total_cost) AS \"Avg\",  percentile_cont(0.5) WITHIN GROUP (ORDER BY total_cost) AS \"Median\" FROM per_session",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {},
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top 10 costliest students (all-time)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "admiq-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "admiq-postgres"
          },
          "format": "table",
          "rawSql": "SELECT s.student_id AS \"Student ID\", s.student_name AS \"Name\", COALESCE(SUM(ce.cost_usd),0) AS \"Total cost ($)\" FROM students s LEFT JOIN cost_events ce ON ce.college_id = s.college_id AND ce.student_id = s.student_id WHERE s.college_id = $college_id::int GROUP BY s.student_id, s.student_name ORDER BY 3 DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
